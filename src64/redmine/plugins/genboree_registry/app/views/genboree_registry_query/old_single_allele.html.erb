<!-- /section -->
<% logger.error("REGISTRY - Render allele") %>
<section class="white-bg">
  <div class="container">
   <div class="panel super-panel">
    <div class="panel-heading super-panel-heading">
      <div class="row">
        <div class="col-sm-12">
          <%= @hash_response["@id"].match(/CA[0-9]+/) %> <br>
        </div>
      </div>
    </div>
    <div class="panel-body super-panel-body">
     <div class="row">
       <% logger.error("REGISTRY - Render genomic allele") %>
       <!-- Genomic alleles -->
       <% if @has_genomic_alleles %>
         <div class="col-sm-12">
            <div class="panel">
               <div class="panel-heading">
                 Genomic Alleles
               </div>
               <div class="panel-body">
                  <%
                    if @has_genomic_alleles
                       @hash_response["genomicAlleles"].each do |allele|
                          allele["hgvs"].each do |expression|
                  %>
                     <div class="col-sm-6">
                  <%=            expression %><br>
                     </div>
                  <%
                          end
                       end
                    end
                  %>
               </div>
            </div>
         </div>
       <% end %>
       <!-- Transcript alleles -->
       <% logger.error("REGISTRY - Render transcript allele") %>
       <% if @has_transcript_alleles %>
         <div class="col-sm-12">
            <div class="panel">
               <div class="panel-heading">
                 Transcript Alleles
               </div>
               <div class="panel-body">
                  <%
                    if @has_genomic_alleles
                       @hash_response["transcriptAlleles"].each do |allele|
                          allele["hgvs"].each do |expression|
                  %>
                             <div class="col-sm-6">
                              <%= expression %>
                             </div>
                  <%
                          end
                       end
                    end
                  %>
               </div>
            </div>
         </div>
       <% end %>
   </div>
    <a class="twitter-share-button"
      href="https://twitter.com/intent/tweet"
      data-text="Allele #<%=@hash_response["@id"].match(/CA[0-9]+/)%> is ? for OMIM: ? as cited in (PMID: ?)"
      data-url="http://reg.genome.network/allele/<%=@hash_response["@id"].match(/CA[0-9]+/)%>"
      >
       Tweet
    </a>
<!--
      data-url="http://reg.genome.network/allele/<%=@hash_response["@id"].match(/CA[0-9]+/)%>.html"
      data-hashtags="<%=@hash_response["@id"].match(/CA[0-9]+/)%>"
-->
</section>

