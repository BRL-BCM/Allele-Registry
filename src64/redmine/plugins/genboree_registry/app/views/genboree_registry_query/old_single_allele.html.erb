<% @hash_response = JSON.parse(@response_from_registry) %>
<% %>
<!-- section class="white-bg" -->
  <% logger.error("REGISTRY - Rendering view") %>
  <div class="container">
   <div class="row new-caid-header">
     <div class="col-sm-8">
        <div class="show-caid">
            <%= @hash_response["@id"].match(/CA[0-9]+/) %>
        </div>
        <div class="show-gene">
            <% logger.error("REGISTRY - Show Gene") %>
            <small><% 
                    begin 
                     %>
                     <%= @gene_response.length > 1 ? "Gene: " : "Genes: " %>
                     <% @gene_response.each do |given_gene|   %>
                     <%=    given_gene["externalRecords"]["HGNC"]["symbol"]  %>
                      <span class="verysmall label">
                       <a class="extlink" href=<%=given_gene["externalRecords"]["NCBI"]["@id"]%> target="_blank">
                        NCBI
                       </a>
                      </span>
                      <span class="verysmall label">
                        <a class="extlink" href=<%=given_gene["externalRecords"]["HGNC"]["@id"]%> target="_blank">
                         HGNC
                        </a>
                      </span>
                      <span class="verysmall label">
                        <a class="extlink" href=http://genome.ucsc.edu/cgi-bin/hgGene?org=human&db=hg38&hgg_gene=<%=given_gene["externalRecords"]["HGNC"]["symbol"]%> target="_blank">
                         UCSC
                        </a>
                      </span>
                      <span class="verysmall label">
                        <a class="extlink" href=http://www.omim.org/search/?search=gene_id:<%=given_gene["externalRecords"]["NCBI"]["id"]%> target="_blank">
                         OMIM
                        </a>
                      </span>
                      <span class="verysmall label">
                        <a class="extlink" href=http://exac.broadinstitute.org/awesome?query=<%=given_gene["externalRecords"]["HGNC"]["symbol"]%> target="_blank">
                         ExAC
                        </a>
                      </span>
                      <span class="verysmall label">
                        <a class="extlink" href=http://gnomad.broadinstitute.org/awesome?query=<%=given_gene["externalRecords"]["HGNC"]["symbol"]%> target="_blank">
                         gnomAD
                        </a>
                      </span>
                     <%
                     end 
                    rescue 
                     ""
                    end
                    %>
            </small>
            <% logger.error("REGISTRY - Done Gene") %>
        </div>
     </div>
  </div>
 </div>

<!-- /section -->

